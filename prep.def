cd ~/smh
cat > containers/prep.def << 'EOF'
Bootstrap: docker
From: condaforge/miniforge3:latest

# CPU-side prep and validation for the smh pipeline.
# Serves stages 0 (filters), 1 (ligands), 2 (receptor), 4 (PoseBusters).
#
# Versions validated 2026-10-13 on UIUC Campus Cluster.
# Base tag is deliberately :latest -- the conda pins do the real work.
#
# posebusters is pip-only (not on conda-forge), hence the pip line. Mixing
# pip into a conda env is the weak point of this recipe: pip cannot see
# conda's dependency graph, so both numpy and posebusters are pinned and the
# import check below is what catches a conflict.
#
# Build (CPU node, ~16 GB RAM, no GPU):
#   export APPTAINER_CACHEDIR=/scratch/$USER/.apptainer
#   export APPTAINER_TMPDIR=/tmp/$USER-build && mkdir -p $APPTAINER_TMPDIR
#   apptainer build --ignore-fakeroot-command prep.sif prep.def
#
# Verify:
#   apptainer exec prep.sif python3 -c "import rdkit, gemmi, posebusters; print('ok')"

%post
    set -e
    conda install -y -c conda-forge \
        python=3.11.16 \
        rdkit=2026.03.6 \
        openbabel=3.2.1 \
        numpy=2.4.6 \
        pandas=3.0.6 \
        gemmi=0.7.5
    pip install --no-cache-dir posebusters==0.6.5
    python3 -c "import rdkit, gemmi, posebusters, pandas; print('import check ok')"
    conda clean -afy

%environment
    export PYTHONNOUSERSITE=1

%runscript
    exec "$@"

%labels
    Maintainer susunt2
    Pipeline   smh
    Stage      prep
    Validated  2026-10-13

%help
    CPU-side tooling for the smh docking pipeline.

      stage 0  src/0filter.py        2D property + alert filters
      stage 1  src/1ligands.py       SMILES -> 3D conformers
      stage 2  src/2protein.py       receptor cleanup + docking box
      stage 4  src/4posebusters.py   pose plausibility filtering
EOF